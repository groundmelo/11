<?xml version="1.0" encoding="utf-8"?>
<!-- 约束布局1：计算器界面（修正Margin属性，匹配文档需求） -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 标题：ConstraintLayoutTest（文档要求） -->
    <Button
        android:id="@+id/btn_10"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:text="2"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/btn_1"
        app:layout_constraintTop_toTopOf="@id/btn_1" />

    <Button
        android:id="@+id/btn_"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:text="3"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/btn_2"
        app:layout_constraintTop_toTopOf="@id/btn_1" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ConstraintLayoutTest"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 输入框：显示0.0（文档要求） -->
    <EditText
        android:id="@+id/et_input"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="0.0"
        android:textSize="20sp"
        android:gravity="end|center_vertical"
        android:background="@android:drawable/edit_text"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/> <!-- 修正：通用Margin属性，无constraint前缀 -->

    <!-- 数字键7（文档要求位置：输入框下方） -->
    <Button
        android:id="@+id/btn_7"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="7"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/et_input"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"/> <!-- 修正：替换layout_constraintMarginTop -->

    <!-- 数字键8（文档要求位置：7右侧） -->
    <Button
        android:id="@+id/btn_8"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="8"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_7"
        app:layout_constraintStart_toEndOf="@id/btn_7"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <!-- 数字键9（文档要求位置：8右侧） -->
    <Button
        android:id="@+id/btn_9"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="9"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_7"
        app:layout_constraintStart_toEndOf="@id/btn_8"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <Button
        android:id="@+id/btn_a"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="+"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_7"
        app:layout_constraintStart_toEndOf="@id/btn_9"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <!-- 数字键4（文档要求位置：7下方） -->
    <Button
        android:id="@+id/btn_4"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="4"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn_7"
        app:layout_constraintStart_toStartOf="@id/btn_7"
        android:layout_marginTop="16dp"/> <!-- 修正：替换layout_constraintMarginTop -->

    <!-- 数字键5（文档要求位置：4右侧） -->
    <Button
        android:id="@+id/btn_5"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="5"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_4"
        app:layout_constraintStart_toEndOf="@id/btn_4"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <!-- 数字键6（文档要求位置：5右侧） -->
    <Button
        android:id="@+id/btn_6"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="6"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_4"
        app:layout_constraintStart_toEndOf="@id/btn_5"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->
    <Button
        android:id="@+id/btn_j"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="-"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_4"
        app:layout_constraintStart_toEndOf="@id/btn_6"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->
    <!-- 数字键1（文档要求位置：4下方） -->
    <Button
        android:id="@+id/btn_1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="1"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn_4"
        app:layout_constraintStart_toStartOf="@id/btn_7"
        android:layout_marginTop="16dp"/> <!-- 修正：替换layout_constraintMarginTop -->

    <!-- 数字键2（文档要求位置：1右侧） -->
    <Button
        android:id="@+id/btn_2"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="2"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_1"
        app:layout_constraintStart_toEndOf="@id/btn_1"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <!-- 数字键3（文档要求位置：2右侧） -->

    <Button
        android:id="@+id/btn_11"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:text="="
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/btn_0"
        app:layout_constraintTop_toTopOf="@id/btn_0" />

    <Button
        android:id="@+id/btn_12"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="112dp"
        android:text="/"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/btn_0"
        app:layout_constraintTop_toTopOf="@id/btn_11" />

    <Button
        android:id="@+id/btn_3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="3"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_1"
        app:layout_constraintStart_toEndOf="@id/btn_2"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <Button
        android:id="@+id/btn_c"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="*"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/btn_1"
        app:layout_constraintStart_toEndOf="@id/btn_3"
        android:layout_marginStart="16dp"/> <!-- 修正：替换layout_constraintMarginStart -->

    <!-- 数字键0（文档要求位置：1下方，跨2列） -->
    <Button
        android:id="@+id/btn_0"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="0"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn_1"
        app:layout_constraintStart_toStartOf="@id/btn_7"
        app:layout_constraintEnd_toEndOf="@id/btn_5"
        android:layout_marginTop="16dp"/> <!-- 修正：替换layout_constraintMarginTop -->

</androidx.constraintlayout.widget.ConstraintLayout>