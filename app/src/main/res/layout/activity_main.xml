<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">      <!-- 关联对应的Activity -->

    <TextView
        android:id="@+id/tv_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="MARS"
    android:textSize="24sp"
    android:textStyle="bold"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="20dp" />  <!-- 顶部间距，推荐用dp单位 -->

    <ImageView
        android:id="@+id/iv_worm"
        android:layout_width="80dp"
    android:layout_height="80dp"
    android:src="@drawable/galaxy"
    android:scaleType="centerCrop"
    app:layout_constraintTop_toBottomOf="@id/tv_title"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginStart="30dp"
    android:layout_marginTop="30dp" />

    <!-- “One Way”文本 -->
    <TextView
        android:id="@+id/tv_one_way"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One Way"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/iv_worm"
    app:layout_constraintStart_toEndOf="@id/iv_worm"
    android:layout_marginStart="20dp" />

    <!-- “1 Traveller”文本 -->
    <TextView
        android:id="@+id/tv_traveller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 Traveller"
        android:textSize="14sp"
        android:textColor="#666666"
        app:layout_constraintTop_toBottomOf="@id/tv_one_way"
    app:layout_constraintStart_toStartOf="@id/tv_one_way"
    android:layout_marginTop="8dp" />

    <!-- 第一个DEPART按钮 -->
    <Button
        android:id="@+id/btn_depart1"
        android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="DEPART"
    android:backgroundTint="#FF5722"
    android:textColor="@android:color/white"
    app:layout_constraintTop_toBottomOf="@id/iv_worm"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@id/btn_depart2"
    app:layout_constraintHorizontal_weight="1"
    android:layout_marginStart="30dp"
    android:layout_marginTop="40dp"
    android:layout_marginEnd="10dp" />

    <!-- 第二个DEPART按钮 -->
    <Button
        android:id="@+id/btn_depart2"
        android:layout_width="166dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF5722"
        android:text="DEPART"
        android:textColor="@android:color/white"
        tools:layout_editor_absoluteX="216dp"
        tools:layout_editor_absoluteY="203dp" />
    <!-- 后续将在此处添加视图元素 -->

    </androidx.constraintlayout.widget.ConstraintLayout>